# PayGuard AI — Environment Configuration
# Copy this file to backend/.env and adjust as needed.

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default, zero setup)
DATABASE_URL=sqlite:///./payguard.db

# PostgreSQL (optional, for production)
# DATABASE_URL=postgresql://user:password@localhost:5432/payguard

# ── AI Layer ──────────────────────────────────────────────────────────────────
# Leave ANTHROPIC_API_KEY empty to use the fully offline mock AI layer.
# Set it to enable real Claude-powered intent extraction and fraud explanation.
ANTHROPIC_API_KEY=

# Set to "false" to force use of the Anthropic API even when a key is present.
USE_MOCK_AI=true

# ── Risk Engine Weights ────────────────────────────────────────────────────────
# Weights must sum to 1.0.
WEIGHT_INTENT=0.30
WEIGHT_BASKET=0.20
WEIGHT_MERCHANT=0.20
WEIGHT_AGENT=0.15
WEIGHT_MANDATE=0.15

# ── Risk Thresholds ────────────────────────────────────────────────────────────
# Score 0–THRESHOLD_LOW     → LOW RISK    → APPROVE
# Score THRESHOLD_LOW–MEDIUM → MEDIUM RISK → REVIEW
# Score THRESHOLD_MEDIUM–HIGH → HIGH RISK  → HOLD
# Score above THRESHOLD_HIGH  → CRITICAL   → BLOCK
THRESHOLD_LOW=30
THRESHOLD_MEDIUM=60
THRESHOLD_HIGH=80
